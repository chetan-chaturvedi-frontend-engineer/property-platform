# Copy to .env.development (npm run dev) or .env.local; both are git-ignored. In CI/CD set these
# variables in the pipeline. The environment (development/staging/production) follows the Vite mode.
# Every VITE_* value is compiled into the public JavaScript bundle: never put API keys or secrets here.

# Backend API base URL.
#   http://localhost:8080/api/v1  - call the backend directly (dev; backend CORS allows localhost:5173)
#   /api/v1                       - same origin: Vite dev proxy locally, reverse proxy in production
#   https://api.example.com/api/v1 - another host of the SAME site as the dashboard (needs backend CORS)
# The session lives in HttpOnly SameSite=Strict cookies, so the dashboard and the API must be same-site
# (e.g. admin.example.com + api.example.com), and HTTPS outside local development.
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT_MS=15000
VITE_APP_NAME=Property Admin

# Override the environment derived from the mode: development | staging | production
# VITE_APP_ENV=staging

# true/false: answer API calls in the browser with MSW mocks (default: true only in mock mode)
# VITE_ENABLE_MOCKS=false

# Dev server only (not exposed to the browser): target of the /api proxy when VITE_API_BASE_URL=/api/v1.
API_PROXY_TARGET=http://localhost:8080
