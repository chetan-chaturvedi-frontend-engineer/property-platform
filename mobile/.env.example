# Copy to .env (git-ignored). Values are baked into the app bundle at build time, so never put
# secrets here. After editing, restart Metro with: npm start -- --reset-cache
#
# Physical Android phone over USB: run `adb reverse tcp:8080 tcp:8080`, then use localhost.
# Android emulator: http://10.0.2.2:8080/api/v1   iOS simulator: http://localhost:8080/api/v1
API_BASE_URL=http://localhost:8080/api/v1
REQUEST_TIMEOUT_MS=15000
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
SUPPORT_EMAIL=support@example.com
