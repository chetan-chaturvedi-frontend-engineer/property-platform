# Repo-wide rules. App-specific build output lives in each app's own .gitignore.

### Secrets & environment ###
# Real values come from env vars / a secret manager; only *.example templates are committed.
.env
.env.*
*.env
!.env.example
!*.env.example
.envrc
secrets/
*.secret
*.secrets
credentials.json
client_secret*.json
service-account*.json
*-service-account.json

# Private keys & certificates
*.pem
*.key
*.crt
*.cer
*.der
*.p8
*.p12
*.pfx
*.jks
*.keystore
!debug.keystore
*.mobileprovision
id_rsa*
id_ed25519*
*.gpg
*.asc

# Cloud / infra state that may embed secrets
.aws/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

### Database dumps & local data ###
*.dump
*.backup
*.sql.gz
*.sql.zip
*.sqlite
*.sqlite3
*.db

### Logs ###
logs/
*.log
hs_err_pid*
replay_pid*

### OS ###
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

### Editors & IDEs ###
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath

