# Copy to .env (never commit .env) or set in your deployment's secret manager.

# Database
DB_URL=jdbc:postgresql://localhost:5432/property_app
DB_USERNAME=property_user
DB_PASSWORD=

# Required secrets, at least 32 bytes each: openssl rand -base64 48
JWT_SECRET=
OTP_HMAC_SECRET=
JWT_ISSUER=property-platform
JWT_AUDIENCE=property-platform-app

# Admin dashboard origins, comma-separated
CORS_ALLOWED_ORIGINS=https://admin.example.com

# OTP delivery: email none|smtp, sms none (log only works with the dev profile)
OTP_EMAIL_PROVIDER=smtp
OTP_SMS_PROVIDER=none
OTP_EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Razorpay (subscription payments). Test keys start with rzp_test_. Leave blank to disable paid plans.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
